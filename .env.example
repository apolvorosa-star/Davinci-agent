# Copia este archivo a .env y rellena las claves que uses.
# DaVinci Agent expande ${VAR} en config/settings*.yaml desde estas variables.

# Router local multi-key (apiBase: http://localhost:3001/v1)
FREEAPI_KEY=

# Proveedores directos (opcional, solo si los activas en settings.yaml)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
